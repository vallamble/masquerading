# Copier en .env et remplir (ne jamais committer .env). Dans Portainer, saisir
# ces variables dans l'onglet Environment de la stack.

# Clé API du service : les workflows Securiti l'envoient dans le header X-Api-Key.
SERVICE_API_KEY=change-me-long-random

# Application Entra (app-only, client credentials) avec Sites.Selected (write)
# sur le site d'Alice, consentie par l'admin du tenant.
GRAPH_TENANT_ID=00000000-0000-0000-0000-000000000000
GRAPH_CLIENT_ID=00000000-0000-0000-0000-000000000000
GRAPH_CLIENT_SECRET=change-me

# Cible SharePoint (déjà figées dans docker-compose.yml, surchargeables ici) :
# SP_HOSTNAME=m365x42057173.sharepoint.com
# SP_SITE_PATH=            # vide = site racine du tenant
# SP_LIBRARY=Documents
